{
  "name": "duxo-desktop",
  "version": "3.7.0",
  "private": true,
  "description": "Duxo desktop application",
  "author": "apxllo",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "npm run typecheck && npm run compile && npm run compile:renderer && npm run stage-runtime && node scripts/build.mjs && npm run prepare-icons && electron-builder",
    "typecheck": "tsc --noEmit",
    "compile": "tsc",
    "compile:renderer": "tsc -p renderer/tsconfig.json",
    "stage-runtime": "node scripts/stage-runtime.mjs",
    "prepare-icons": "node scripts/prepare-icons.mjs",
    "start": "npm run compile && npm run compile:renderer && npm run stage-runtime && node scripts/build.mjs && electron ."
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "electron": "44.2.0",
    "electron-builder": "26.16.0",
    "png-to-ico": "3.0.2",
    "sharp": "0.34.5",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "com.apxllo.duxo",
    "productName": "Duxo",
    "asar": true,
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "duxo-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterPack": "./scripts/afterPack.cjs",
    "buildResources": "build",
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "zip"
      ],
      "category": "public.app-category.games",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
